---------------------------------------------------------------------
-- SERVICES
---------------------------------------------------------------------
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local player = Players.LocalPlayer
local backpack = player:WaitForChild("Backpack")
local char = player.Character or player.CharacterAdded:Wait()

-- Pas dit aan naar jouw remote pad:
local TradeRemote = ReplicatedStorage:WaitForChild("Events")
    :WaitForChild("BabyCats")
    :WaitForChild("Trade")

---------------------------------------------------------------------
-- TELEPORT BUTTON (OPTIONEEL)
---------------------------------------------------------------------
local tpGui = Instance.new("ScreenGui")
tpGui.Name = "TPGui"
tpGui.ResetOnSpawn = false
tpGui.Parent = player:WaitForChild("PlayerGui")

local tpButton = Instance.new("TextButton")
tpButton.Name = "TPButton"
tpButton.Parent = tpGui
tpButton.Size = UDim2.new(0, 150, 0, 50)
tpButton.Position = UDim2.new(0.5, -75, 0.7, 0)
tpButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
tpButton.Text = "TP me"
tpButton.TextScaled = true
tpButton.BorderSizePixel = 0

local PLACE_ID = 103881829323430

tpButton.MouseButton1Click:Connect(function()
    TeleportService:Teleport(PLACE_ID, player)
end)

---------------------------------------------------------------------
-- RAINBOW TRADE GUI
---------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "RainbowTradeGUI"
