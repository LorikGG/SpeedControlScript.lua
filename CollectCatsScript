tradeBtn.Parent = frame

---------------------------------------------------------------------
-- FUNCTIONS
---------------------------------------------------------------------
local function equipAllRainbowChickens()
    for _, item in ipairs(backpack:GetChildren()) do
        if item.Name == "Chicken [Rainbow]" then
            item.Parent = char
        end
    end
end

local function spamTrade(times, delay)
    times = times or 70
    delay = delay or 0.01

    for i = 1, times do
        TradeRemote:InvokeServer()
        task.wait(delay)
    end
end

---------------------------------------------------------------------
-- BUTTON LOGIC
---------------------------------------------------------------------
tradeBtn.MouseButton1Click:Connect(function()
    equipAllRainbowChickens()
    task.wait(0.01)
    spamTrade(70, 0.01)
end)
